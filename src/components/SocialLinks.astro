---
import { site } from '@/site.config';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const items = [
  { key: 'email', label: 'Email', href: `mailto:${site.email}`, icon: 'mail' },
  ...(site.links.scholar ? [{ key: 'scholar', label: 'Scholar', href: site.links.scholar, icon: 'scholar' }] : []),
  ...(site.links.github ? [{ key: 'github', label: 'GitHub', href: site.links.github, icon: 'github' }] : []),
  { key: 'linkedin', label: 'LinkedIn', href: site.links.linkedin, icon: 'linkedin' }
];
---

<div class:list={['social-links', { compact }]} aria-label="Contact and profiles">
  {items.map((item) => (
    <a href={item.href} target={item.key === 'email' ? undefined : '_blank'} rel={item.key === 'email' ? undefined : 'noreferrer'} aria-label={item.label} title={item.label}>
      {item.icon === 'mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17v11h-17z"/><path d="m4 7 8 6 8-6"/></svg>}
      {item.icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9v10M5 5.5v.1M10 19v-6c0-2 1.3-3.5 3.3-3.5 2.2 0 3.7 1.4 3.7 4V19M10 10v9"/></svg>}
      {item.icon === 'github' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.2-4-2-5-2.5M14.5 22v-3.1c0-.9.1-1.4-.4-2 3.8-.4 7.9-1.9 7.9-8.5A6.6 6.6 0 0 0 20.2 4 6.1 6.1 0 0 0 20 0s-1.4-.4-4.5 1.7a15.5 15.5 0 0 0-8 0C4.4-.4 3 0 3 0a6.1 6.1 0 0 0-.2 4A6.6 6.6 0 0 0 1 8.4c0 6.6 4 8 7.9 8.5-.5.5-.8 1.1-.8 2V22"/></svg>}
      {item.icon === 'scholar' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m2 9 10-6 10 6-10 6z"/><path d="M6 12v5c3 3 9 3 12 0v-5M22 9v7"/></svg>}
      {!compact && <span>{item.label}</span>}
    </a>
  ))}
</div>
