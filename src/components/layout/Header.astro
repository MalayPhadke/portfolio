---
import SocialLinks from '@/components/SocialLinks.astro';
import { site, withBase } from '@/site.config';

const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { label: 'Home', href: withBase(), match: withBase().replace(/\/$/, '') },
  { label: 'Research', href: withBase('research/'), match: withBase('research') },
  { label: 'Publications', href: withBase('publications/'), match: withBase('publications') },
  { label: 'Projects', href: withBase('projects/'), match: withBase('projects') }
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={withBase()} aria-label={`${site.name}, home`}>
      <span class="wordmark-mark" aria-hidden="true">MP</span>
      <span>{site.name}</span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={path === link.match ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href={withBase(site.links.cv)} target="_blank" rel="noreferrer">CV <span aria-hidden="true">↗</span></a>
    </nav>

    <div class="header-actions">
      <SocialLinks compact />
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"/></svg>
      </button>
    </div>
  </div>
</header>
